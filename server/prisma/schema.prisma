// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model sleep_records {
  id                    Int      @id @default(autoincrement())
  side                  String
  entered_bed_at        Int
  left_bed_at           Int
  sleep_period_seconds  Int
  times_exited_bed      Int
  present_intervals     String
  not_present_intervals String

  @@unique([side, entered_bed_at])
  // Create an index on 'side' and 'entered_bed_at'
  @@index([side, entered_bed_at])
}

model vitals {
  id             Int    @id @default(autoincrement())
  side           String
  timestamp      Int // Unix seconds; the stream writes about one row a minute
  heart_rate     Float? // bpm, 0 means no estimate
  hrv            Float? // SDNN in ms, 0 means no estimate
  breathing_rate Float? // breaths per minute, 0 means no estimate

  @@unique([side, timestamp]) // Ensure no duplicate intervals
  @@index([side, timestamp])
}


model movement {
  id              Int      @id @default(autoincrement())
  timestamp       Int
  side            String
  // INTEGER in the migration, but SQLite keeps the fractions the analyzer
  // writes; Float reads them as stored. Deliberately no migration.
  total_movement  Float
  @@unique([side, timestamp]) // Ensure no duplicate intervals
  @@index([side, timestamp])
}

model calibration_profiles {
  id           Int    @id @default(autoincrement())
  side         String
  sensor_type  String
  payload      String
  quality      Float
  source_start Int
  source_end   Int
  samples_used Int
  run_id       Int
  created_at   Int

  @@unique([side, sensor_type])
}

model calibration_runs {
  id          Int     @id @default(autoincrement())
  side        String
  sensor_type String
  status      String
  trigger     String
  started_at  Int
  duration_ms Int
  quality     Float?
  message     String?
  // What the run measured, kept per run because calibration_profiles is
  // upserted per (side, sensor_type) and so holds only the latest. Nullable:
  // failed and skipped runs measured nothing.
  payload      String?
  source_start Int?
  source_end   Int?

  @@index([side, started_at])
}

// One row per sleep analyzer run, written by the biometrics jobs. The server
// only reads it.
model analysis_runs {
  id               Int     @id @default(autoincrement())
  side             String
  kind             String
  started_at       Int
  finished_at      Int?
  window_start     Int
  window_end       Int
  status           String
  rows_loaded      Int?
  records_written  Int?
  movement_written Int?
  duration_ms      Int?
  peak_rss_mb      Float?
  error            String?
  code_version     String?

  @@index([side, started_at])
}



// Transitions of the tank's water sensor between ok and low, not every
// reading, so "low since" survives a restart.
model water_level_events {
  id        Int    @id @default(autoincrement())
  timestamp Int
  level     String

  @@index([timestamp])
}
