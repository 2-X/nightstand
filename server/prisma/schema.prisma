// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model sleep_records {
  id                    Int      @id @default(autoincrement())
  side                  String
  entered_bed_at        Int
  left_bed_at           Int
  sleep_period_seconds  Int
  times_exited_bed      Int
  present_intervals     String
  not_present_intervals String

  @@unique([side, entered_bed_at])
  // Create an index on 'side' and 'entered_bed_at'
  @@index([side, entered_bed_at])
}

model vitals {
  id             Int    @id @default(autoincrement())
  side           String
  timestamp      Int // 5-minute interval start (Unix timestamp)
  heart_rate     Float? // Averaged over 5 minutes
  hrv            Float? // Averaged over 5 minutes
  breathing_rate Float? // Averaged over 5 minutes

  @@unique([side, timestamp]) // Ensure no duplicate intervals
  @@index([side, timestamp])
}


model movement {
  id              Int      @id @default(autoincrement())
  timestamp       Int
  side            String
  total_movement  Int
  @@unique([side, timestamp]) // Ensure no duplicate intervals
  @@index([side, timestamp])
}

model calibration_profiles {
  id           Int    @id @default(autoincrement())
  side         String
  sensor_type  String
  payload      String
  quality      Float
  source_start Int
  source_end   Int
  samples_used Int
  run_id       Int
  created_at   Int

  @@unique([side, sensor_type])
}

// --- Phase 0 "collect everything" data layer ---
// All four tables below are written ONLY by src/db/collector.ts.

// Per-side bed state time series. One row per side, written on-change (level,
// target, or isOn) with a 60s heartbeat floor. Fed from the eventBus
// 'device-status' stream, never a new dac.sock caller.
model bed_state_samples {
  id            Int     @id @default(autoincrement())
  side          String
  timestamp     Int // epoch seconds
  current_level Int?
  target_level  Int?
  current_temp_f Float?
  target_temp_f Float?
  is_on         Boolean

  @@unique([side, timestamp])
  @@index([side, timestamp])
}

// Hub-wide state time series (ambient/heatsink/water temps, priming, wifi).
// On-change-or-60s over ambient/heatsink/water/priming/wifi.
model hub_state_samples {
  id           Int      @id @default(autoincrement())
  timestamp    Int // epoch seconds
  ambient_c    Float?
  heatsink_c   Float?
  left_c       Float?
  right_c      Float?
  water_ok     Boolean?
  is_priming   Boolean?
  wifi_strength Int?

  @@unique([timestamp])
}

// Discrete event journal (alarm fired/cleared, power on/off, prime, water,
// taps, base moves, boot, manual temp change...). payload is JSON.
model pod_events {
  id        Int    @id @default(autoincrement())
  timestamp Int // epoch seconds
  type      String
  side      String?
  payload   String // JSON
  source    String // module/route that emitted it

  @@index([type, timestamp])
  @@index([timestamp])
}

// Append-only config/command audit: every schedules/settings write, every
// hardware command (scheduler or user), base control. snapshot is JSON.
model config_audit {
  id        Int    @id @default(autoincrement())
  timestamp Int // epoch seconds
  kind      String // schedules | settings | device_status | execute | base_control
  source    String
  snapshot  String // JSON of new state / command payload

  @@index([kind, timestamp])
}

model calibration_runs {
  id          Int     @id @default(autoincrement())
  side        String
  sensor_type String
  status      String
  trigger     String
  started_at  Int
  duration_ms Int
  quality     Float?
  message     String?
  // What the run measured, kept per run because calibration_profiles is
  // upserted per (side, sensor_type) and so holds only the latest. Nullable:
  // failed and skipped runs measured nothing.
  payload      String?
  source_start Int?
  source_end   Int?

  @@index([side, started_at])
}


